{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.9.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost",
    "expo:docker": "WEB_BROWSERS_ALLOWED_ORIGINS=https://expo.pixel-eucaristico.com.br EXPO_UNSAFE_ALLOW_ALL_WEB_ORIGINS=true EXPO_DEV_ALLOW_REMOTE_HOSTS=expo.pixel-eucaristico.com.br EXPO_PACKAGER_PROXY_URL=https://expo.pixel-eucaristico.com.br REACT_NATIVE_PACKAGER_HOSTNAME=expo.pixel-eucaristico.com.br npx expo start --port 8081 --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "start": "npx expo start",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "android": "JAVA_HOME=/c/Users/willianquintino/AppData/Local/Programs/Java/jdk-17 expo run:android",
    "ios": "expo run:ios"
  },
