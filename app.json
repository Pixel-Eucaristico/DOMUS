{
  "expo": {
    "name": "DOMUS",
    "slug": "domus",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orcafacil",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F7FA",
      "dark": {
        "image": "./assets/images/splash-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "android": {
      "package": "br.com.pixeleucaristico.domus",
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F5F7FA",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "br.com.pixeleucaristico.domus",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "DOMUS precisa acessar a câmera para OCR de notas fiscais.",
        "NSPhotoLibraryUsageDescription": "DOMUS precisa acessar suas fotos para importar imagens de notas fiscais.",
        "NSMicrophoneUsageDescription": "DOMUS não usa o microfone.",
        "NSFaceIDUsageDescription": "DOMUS usa Face ID para proteger o acesso aos seus dados financeiros.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-router",
        {}
      ],
      "expo-font",
      "expo-web-browser",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "DOMUS precisa acessar a câmera para escanear QR Codes e tirar fotos de notas fiscais.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DOMUS precisa acessar suas fotos para importar imagens de notas fiscais."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "DOMUS precisa acessar a câmera para OCR de notas fiscais.",
          "enableCodeScanner": false
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          }
        }
      ],
      "expo-secure-store",
      "expo-audio",
      [
        "rn-mlkit-ocr/app.plugin.js",
        {
          "ocrModels": [
            "latin"
          ],
          "ocrUseBundled": true
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-notifications",
      [
        "@react-native-firebase/app",
        {
          "android_app_id": "1:1098581898317:android:b7ffd1c59df1ae8170d804",
          "ios_app_id": "1:1098581898317:ios:9c62b90f5890f34870d804"
        }
      ],
      "@react-native-firebase/perf",
      "@react-native-firebase/crashlytics",
      "./plugins/withGwpAsan",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8693115758199908~8641009249",
          "iosAppId": "ca-app-pub-8693115758199908~8641009249"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c61c9eb7-1884-4245-9419-eb099e085df5"
      }
    },
    "owner": "pixel-eucaristico"
  }
}
