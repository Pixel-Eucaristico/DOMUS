{
  "expo": {
    "name": "DOMUS",
    "slug": "orcafacil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orcafacil",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E63"
    },
    "android": {
      "package": "com.orcafacil",
      "adaptiveIcon": {
        "backgroundColor": "#1B5E63",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.orcafacil",
      "infoPlist": {
        "NSCameraUsageDescription": "DOMUS precisa acessar a câmera para escanear QR Codes e tirar fotos de notas fiscais.",
        "NSPhotoLibraryUsageDescription": "DOMUS precisa acessar suas fotos para importar imagens de notas fiscais.",
        "NSMicrophoneUsageDescription": "DOMUS não usa o microfone.",
        "NSFaceIDUsageDescription": "DOMUS usa Face ID para proteger o acesso aos seus dados financeiros."
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://expo.pixel-eucaristico.com.br/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "DOMUS precisa acessar a câmera para escanear QR Codes e tirar fotos de notas fiscais.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DOMUS precisa acessar suas fotos para importar imagens de notas fiscais."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "DOMUS precisa acessar a câmera para OCR de notas fiscais.",
          "enableCodeScanner": false
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
